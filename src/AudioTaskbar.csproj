<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIAutomationClient (System.Windows.Automation) for exact taskbar icon bounds -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>AudioTaskbar</AssemblyName>
    <RootNamespace>AudioTaskbar</RootNamespace>
    <Version>5.1.1</Version>
    <Product>Audio Taskbar</Product>
    <Description>Living regional weather diorama for the Windows taskbar (icon-safe at any DPI). Toggle with F8.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TaskbarTap\TaskbarTap.dll" LogicalName="AudioTaskbar.TaskbarTap.dll" Condition="Exists('TaskbarTap\TaskbarTap.dll')" />
    <EmbeddedResource Include="..\native\out\TaskbarTap.dll" LogicalName="AudioTaskbar.TaskbarTap.dll" Condition="Exists('..\native\out\TaskbarTap.dll') And !Exists('TaskbarTap\TaskbarTap.dll')" />
  </ItemGroup>
</Project>
