<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIAutomationClient (System.Windows.Automation) for exact taskbar icon bounds -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>AudioTaskbar</AssemblyName>
    <RootNamespace>AudioTaskbar</RootNamespace>
    <Version>5.4.2</Version>
    <FileVersion>5.4.2.0</FileVersion>
    <InformationalVersion>5.4.2</InformationalVersion>
    <Product>Audio Taskbar</Product>
    <AssemblyTitle>Audio Taskbar</AssemblyTitle>
    <Company>Hieunguyen00000</Company>
    <Authors>Hieunguyen00000</Authors>
    <Copyright>Copyright (c) 2026 Hieunguyen00000</Copyright>
    <Description>Living regional weather diorama for the Windows taskbar (icon-safe at any DPI). Toggle with F8.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Microsoft Store / MSIX: retarget for WinRT (StartupTask, ApplicationData) without changing the portable build. -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <DefineConstants>$(DefineConstants);STORE_BUILD</DefineConstants>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AudioTaskbar.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Ogg Vorbis decoding (NAudio.Vorbis + NVorbis, both MIT) for the embedded CC0 recordings -->
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- v5.4.1: CC0 recordings (credits in NOTICE.md), logical names AudioTaskbar.Sounds.<name>.ogg -->
    <EmbeddedResource Include="Sounds\*.ogg" LogicalName="AudioTaskbar.Sounds.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Portable / NSIS: embed TaskbarTap.dll and extract at runtime. The Store build ships it as a loose, package-signed file instead. -->
    <EmbeddedResource Include="TaskbarTap\TaskbarTap.dll" LogicalName="AudioTaskbar.TaskbarTap.dll" Condition="Exists('TaskbarTap\TaskbarTap.dll') And '$(StoreBuild)' != 'true'" />
    <EmbeddedResource Include="..\native\out\TaskbarTap.dll" LogicalName="AudioTaskbar.TaskbarTap.dll" Condition="Exists('..\native\out\TaskbarTap.dll') And !Exists('TaskbarTap\TaskbarTap.dll') And '$(StoreBuild)' != 'true'" />
    <None Include="TaskbarTap\TaskbarTap.dll" Condition="Exists('TaskbarTap\TaskbarTap.dll') And '$(StoreBuild)' == 'true'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
