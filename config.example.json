{
  "fps": 30,
  "mode": "diorama",
  "hotkey": "F8",
  "showOnAllMonitors": true,
  "hideWhenFullscreen": true,
  "iconSafeFade": true,
  "iconSafePadding": 28,
  "blockWallpaper": true,
  "backdropOpacity": 1.0,
  "fuseIntoTaskbar": false,
  "makeTaskbarTransparent": false,
  "enableAudio": false,
  "showSpectrum": false,
  "showWaveform": false,
  "preset": "aurora",
  "intensity": 1.0,
  "showTrain": true,
  "showAirplane": true,
  "showCyclist": true,
  "showAmbientDetails": true,
  "showWeatherEffects": true,
  // live | sunny | cloudy | rain | storm | snow (v5.2: "Tuyết rơi") | night
  "weatherPreview": "live",
  "showWeather": true,
  "showWeatherAmbient": true,
  "weatherPosition": "left",
  "weatherUnits": "celsius",
  "weatherCity": "",
  "weatherLatitude": null,
  "weatherLongitude": null,
  "weatherRefreshMinutes": 15,
  "weatherOnPrimaryOnly": true,
  "trainCrossingMinutes": 2,
  "airplaneCycleMinutes": 3,
  "regionMode": "auto",
  // v5.4: thẻ thời tiết trên taskbar đã bỏ; thông tin vị trí/thời tiết nằm trong bảng điều khiển (khóa này bị bỏ qua)
  "showWeatherHud": false,
  "weatherFollowsRegion": false,
  "tapMode": "auto",
  "tapTimeoutSeconds": 3.5,
  // timeMode: "cycle" (theo chu kỳ tùy chỉnh) | "real" (giờ thật) | "day" (cố định ban ngày) | "night" (cố định ban đêm)
  "timeMode": "cycle",
  // v5.3.1: độ dài 1 ngày ảo ở chế độ cycle, tùy chỉnh 0.5 – 10080 phút (mặc định 30)
  "dayCycleMinutes": 30,
  "dayCycleOffsetHours": 0,
  // v5.4.2: mùa — "real" (Thực tế, theo ngày và vị trí) | "cycle" (Tự đổi mùa) | spring | summer | autumn | winter
  "season": "summer",
  "seasonCycleMinutes": 30,
  "showIconPadding": true,
  // v5.4.2: weatherPreview = "random" (Ngẫu nhiên) đổi thời tiết sau một khoảng ngẫu nhiên trong [min, max] phút
  "weatherCycleRandomMinMinutes": 5,
  "weatherCycleRandomMaxMinutes": 20,
  // âm thanh nền 0–100. Âm lượng tổng MẶC ĐỊNH = 0 (im lặng) và chỉ do bạn chỉnh.
  // v5.4.2: soundAutoMix = tự phối từng hiệu ứng theo cảnh; hiệu ứng trong soundManual dùng giá trị soundVolumes của bạn
  "soundMasterVolume": 0,
  "soundAutoMix": true,
  "soundManual": [],
  "soundVolumes": { "rain": 0, "thunder": 0, "wind": 0, "traffic": 0, "horns": 0, "train": 0, "airplane": 0, "birds": 0, "insects": 0, "animals": 0, "waves": 0 },
  // v5.3: bảng điều khiển + tự động cập nhật
  "startMinimized": false,
  "autoUpdateEnabled": true,
  "autoUpdateSilentInstall": true,
  "updateRepo": "Hieunguyen00000/AudioTaskbar",
  // URL http(s) tới latest.json tĩnh; để trống = dùng GitHub Releases của updateRepo
  "updateFeedUrl": ""
}
